{
  "name": "steam-rep4rep",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Steam friends userscript with release-based Greasy Fork distribution",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node --check rep4rep.user.js && prettier --check . && node scripts/build.mjs",
    "format": "prettier --write .",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && playwright test",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.8.5"
  }
}
